{
  "name": "@nexustools/aitooling",
  "version": "1.0.0-beta.1",
  "description": "Unified AI Tooling, Context-Aware Tool Registry, Live Partial-JSON & Stream Parser, Multi-Provider Clients (OpenAI, Claude, Gemini, Grok, LM Studio), and Live AI Chat UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./src/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NexusTools/AITooling.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "keywords": [
    "ai",
    "tools",
    "function-calling",
    "streaming",
    "openai",
    "claude",
    "gemini",
    "grok",
    "lm-studio",
    "nexustools",
    "aicore",
    "hacanvas"
  ],
  "author": "NexusTools",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.0",
    "google-auth-library": "^9.15.1",
    "openai": "^4.86.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
